{
     "name": "shadcn-tanstack-router",
     "private": true,
     "version": "1.0.0",
     "type": "module",
     "scripts": {
          "dev": "vite",
          "build": "tsc && vite build",
          "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && npx tsc --noEmit && prettier -c \"**/*.{js,jsx,ts,tsx,json}\" && knip",
          "test": "vitest",
          "coverage": "vitest run --coverage",
          "coverage:silent": "vitest run --coverage --silent --reporter=dot",
          "preview": "vite preview",
          "format": "prettier --write .",
          "check-unused": "knip"
     },
     "lint-staged": {
          "*.{ts,tsx}": [
               "prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
               "eslint --max-warnings 0 --no-warn-ignored ."
          ],
          "*.test.{js,ts,tsx}": [
               "vitest run --passWithNoTests"
          ]
     },
     "dependencies": {
          "@tanstack/react-query": "^5.90.7",
          "@tanstack/react-router": "^1.135.2",
          "clsx": "^2.1.1",
          "lucide-react": "^0.321.0",
          "react": "^18.3.1",
          "react-dom": "^18.3.1"
     },
     "devDependencies": {
          "@tailwindcss/postcss": "^4.1.17",
          "@tanstack/react-router-devtools": "^1.135.2",
          "@tanstack/router-vite-plugin": "^1.135.2",
          "@testing-library/jest-dom": "^6.9.1",
          "@testing-library/react": "^16.3.0",
          "@types/eslint__js": "^8.42.3",
          "@types/node": "^20.19.24",
          "@types/react": "^18.3.26",
          "@types/react-dom": "^18.3.7",
          "@typescript-eslint/utils": "^8.46.4",
          "@vitejs/plugin-react": "^4.7.0",
          "@vitest/coverage-v8": "^3.2.4",
          "eslint": "^8.57.1",
          "husky": "^9.1.7",
          "jsdom": "^26.1.0",
          "knip": "^5.68.0",
          "lint-staged": "^16.2.6",
          "postcss": "^8.5.6",
          "prettier": "^3.6.2",
          "prettier-plugin-organize-imports": "^4.3.0",
          "prettier-plugin-tailwindcss": "^0.6.14",
          "tailwind-merge": "^2.6.0",
          "tailwindcss": "^4.1.17",
          "tailwindcss-animate": "^1.0.7",
          "typescript": "^5.9.3",
          "typescript-eslint": "^8.46.4",
          "vite": "^7.2.2",
          "vitest": "^3.2.4"
     }
}
